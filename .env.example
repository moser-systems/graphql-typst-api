# Required
GRAPHQL_TYPST_API_BUNDLE_DIR=examples/bundle
GRAPHQL_TYPST_API_GRAPHQL_URL=http://localhost:8080/graphql

# Upstream authentication (the full header value, including any scheme)
#GRAPHQL_TYPST_API_GRAPHQL_AUTH_HEADER_VALUE=Bearer xxxxx
#GRAPHQL_TYPST_API_GRAPHQL_AUTH_HEADER_NAME=Authorization

# Inbound authentication. Unset means the API is open.
#GRAPHQL_TYPST_API_API_KEY=change-me
#GRAPHQL_TYPST_API_API_KEY_HEADER=X-API-Key

# Operations
#GRAPHQL_TYPST_API_LOG_FORMAT=console
#GRAPHQL_TYPST_API_LOG_LEVEL=DEBUG
#GRAPHQL_TYPST_API_DEBUG_ERRORS=true
#GRAPHQL_TYPST_API_METRICS_ENABLED=true
#GRAPHQL_TYPST_API_RENDER_CONCURRENCY=4
